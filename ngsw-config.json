{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/branding/**",
          "/assets/icons/**",
          "/assets/illustrations/**",
          "/assets/categories/**",
          "/assets/dishes/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/media/**",
    "!/assets/feed/**",
    "!/admin/**",
    "!/*.MP4",
    "!/*.mp4"
  ]
}
